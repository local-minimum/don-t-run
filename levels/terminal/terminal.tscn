[node name="Elevaor Internal" type="Node" parent="TerminalGame/Ground Floor" unique_id=627600762 node_paths=PackedStringArray("passes")]
script = ExtResource("9_4ov15")
state_check = "KNOWS FLOOR"
passes = [NodePath("Floor Buttons")]
fails_description = 1
location = "ELEVATOR"
_descriptions = Array[String](["The elevator seems to beckon you to press the button labeled \"6.\"", "The elevator waits for you to indicate what floor you want to go to, but you don't have a clue which. And you are not going to be a bad citizen and press all buttons at once."])
metadata/_custom_type_script = "uid://gsfx6wsb66de"

[node name="Floor Buttons" type="Node" parent="TerminalGame/Ground Floor/Elevaor Internal" unique_id=2127392556 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "BUTTONS"
place = NodePath("../../../6th Floor/6th Floor Reception")
blocked = true
_descriptions = Array[String](["You take a deep breath{SIGNAL breath} - whatever this is, it cannot be that bad - and press the 6.
{CURSOR 2}{WAIT 2}{CURSOR 0}{SIGNAL going-up}
The door closes - almost soundlessly.  And the elevator speeds upwards much too fast for just a six stories.
{CURSOR 2}{MORE}{CURSOR 0}{CLEAR}"])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Lobby" type="Node" parent="TerminalGame/Ground Floor/Elevaor Internal" unique_id=584847606 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
place = NodePath("../../Lobby")
_descriptions = Array[String](["You sense that you are not yet ready."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="6th Floor" type="Node" parent="TerminalGame" unique_id=837745511]

[node name="6th Floor Reception" type="Node" parent="TerminalGame/6th Floor" unique_id=1030407607 node_paths=PackedStringArray("inv_check", "passes", "fails")]
script = ExtResource("9_4ov15")
inv_check = NodePath("Visitors Badge")
state_check = "EXPECTED"
passes = [NodePath("Door to Conference"), NodePath("Look Door to Conference"), NodePath("Left Door to Hall"), NodePath("Look Left Door to Hall"), NodePath("Right Door to Hall"), NodePath("Look Right Door to Hall")]
passes_description = -1
fails = [NodePath("Doors")]
fails_description = -1
location = "RECEPTION"
_descriptions = Array[String](["The elevator spills you out into another soulless, and abandoned room.

There's a counter. It very much feels like someone should be sitting there.

Behind the counter on the wall, is what must be the company logo. There are a couple small but of sturdy looking firs in various planters and good thing they aren't any exotic flowers as whomever runs this place has turned the AC way, way down.

You are freezing.

You notice several doors leading further into the office and behind you the elevator door closes.", "The reception is decorated with several plants. There's a counter and a logo on the wall behind it. Several doors lead further into the office and there's also the elevator, but you are not going to leave before you are done."])
auto_increment_description = true
add_global_state = Array[String](["FREEZING"])
metadata/_custom_type_script = "uid://gsfx6wsb66de"

[node name="Around" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=73263069]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
_descriptions = Array[String](["The logo behind the counter looks like an eight if the two circles had melted together in the middle. The lower circle is larger than the upper one.

The doors don't look like a visitor ought to wander through alone, but there also is absolutely no one around. The only life is a slight humming sound from the computer behind the reception counter. The receptionist should be back any moment, or so you think."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Elevator" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=996100796]
script = ExtResource("6_g45n6")
triggers = Array[String](["GO ELEVATOR", "USE ELEVATOR"])
_descriptions = Array[String](["You are not done yet. And you are not going to waste another day worrying about this, so you are not leaving."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Counter" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=1696112175]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK COUNTER", "GO COUNTER"])
add_targets = Array[String](["COMPUTER", "BADGE"])
_descriptions = Array[String](["Even though it feels [b]wrong[/b], you walk around the reception counter. You rest your hand against the back of the office chair and you can still feel the lingering warmth of someone having been sitting here just recently.

The computer shows a screen saver. There's also a visitors badge laying next to it."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Computer" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=1375661078]
script = ExtResource("6_g45n6")
triggers = Array[String](["USE COMPUTER", "LOOK COMPUTER"])
hidden = true
_descriptions = Array[String](["As you move the mouse, the screen saver instantly flickers off and you are surprised to discover that the computer was left unlocked.

By the looks of it, a scheduling app is running. The current time marker shows a large block with a single name on it.{WAIT 1} [b]Yours.[/b]{WAIT 1}

You never told them you were coming. How can they know you would be here now?", "You check the computer again. Yes it's your name there. You are [b]expected[/b]. Right now."])
auto_increment_description = true
add_global_state = Array[String](["EXPECTED"])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Take Computer" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=434928469]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE COMPUTER"])
hidden = true
_descriptions = Array[String](["You are no thief{WAIT 0.4} and besides it looks heavy."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Visitors Badge" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=605022537]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK BADGE"])
hidden = true
_descriptions = Array[String](["It is a plastic badge on a lanyard. It says VISITOR with large letters and there's a faint arctic blue eight-looking symbol in the background."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Pickup Visitors Badge" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=1867888759 node_paths=PackedStringArray("pickup")]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE BADGE"])
pickup = [NodePath("../Visitors Badge")]
autoblock = true
hidden = true
_descriptions = Array[String](["There doesn't seem to be [b]anyone[/b] around. And if you were to wander past the doors, you'd would feel much better having a proper badge."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Planters" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=971763997]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK PLANTERS"])
_descriptions = Array[String](["The [b]firs[/b] look well kept, green, and no needles are scattered on the floor around them. The soil is moist and the fragrance from the tree, though subtle, brings back a vivid feeling winter holidays. With that comes a strong urge for a big cup of [b]hot[/b] chocolate, or maybe coffee."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Door to Conference" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=1032068934 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR 1"
place = NodePath("../../Conference Room")
_descriptions = Array[String](["The door on the left wall looks just like the other two doors. Leaning in to listen to it, you cannot make out any sound from the other side.{WAIT 1}

Carefully you reach out to the handle, and open the door up - pretending that you have a right to go wherever you want."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Look Door to Conference" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=745138148]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK DOOR 1"])
_descriptions = Array[String](["In your mind, counting left to right you called this one door 1. Maybe that's a good place as any to start? It looks just like the other two doors, but it is the only door not in the far side wall.

Leaning in to listen to it, you cannot make out any sound from the other side."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Left Door to Hall" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=1850069375 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR 2"
place = NodePath("../../Hall Corner by Lounge")
_descriptions = Array[String](["You thought of this door as door 2 - on the left side of the reception counter.{WAIT 1}

Carefully, you reach out to the handle. Not sure if this is the right thing to do.

The door opens up into a quite long hall and in the far end it bends to the right.

Walking over there, the hall is completely empty: no decoration, no carpet, a simple milky off-white color on all sides, no doors except a single one in the far end.{CURSOR 2}{MORE}{CURSOR 0}{CLEAR}"])
add_global_state = Array[String](["RECEPTION LOUNGE"])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Look Left Door to Hall" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=1685688051]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK DOOR 2"])
_descriptions = Array[String](["There's no obvious indication that this door has been used more or less than any of the other two doors."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Right Door to Hall" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=249625229 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR 3"
place = NodePath("../../Hall Corner by Office")
_descriptions = Array[String](["The third door - on the right side of the reception counter looks like the other two.

If you have the badge and you are expected, then why does this feel so wrong?

The door opens up into a hall and in the distance, it bends to the left.

Walking over there, the hall barren: no posters, a plain concrete floor,  white and grey colors on all sides, no doors except a single one where the hall bends.{CURSOR 2}{MORE}{CURSOR 0}{CLEAR}"])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Look Right Door to Hall" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=124095591]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK DOOR 3"])
_descriptions = Array[String](["It’s on the RIGHT side of the counter and it is the third door according to your logic, so maybe that is the correct way forward? "])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Doors" type="Node" parent="TerminalGame/6th Floor/6th Floor Reception" unique_id=1088954365]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK DOORS", "USE DOORS", "GO DOORS"])
_descriptions = Array[String](["There are [b]three[/b] doors. They look quite similar, if not near identical and non of them give you a hint where you should continue. If you should. There's no discernible noise coming from any of them."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Conference Room" type="Node" parent="TerminalGame/6th Floor" unique_id=759879901]
script = ExtResource("4_3equl")
location = "CONFERENCE ROOM"
_descriptions = Array[String](["The room has a large solid wooden table in the middle that could easily fit more than ten people, yet the only chairs you can see are two cheap looking plastic chairs off in one corner. 

There's a projector, a whiteboard and the door you came in through."])
metadata/_custom_type_script = "uid://gsfx6wsb66de"

[node name="Around" type="Node" parent="TerminalGame/6th Floor/Conference Room" unique_id=1800992904]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
_descriptions = Array[String](["The projector seems to be connected to with both an Ethernet cable and power."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Door" type="Node" parent="TerminalGame/6th Floor/Conference Room" unique_id=1425348728 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR"
place = NodePath("../../6th Floor Reception")
_descriptions = Array[String](["You go back to the reception area."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Projector" type="Node" parent="TerminalGame/6th Floor/Conference Room" unique_id=680804291]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK PROJECTOR"])
_descriptions = Array[String](["It is your generic, but modern office appliance. On the cheaper side, light-weight and standing in the middle of the table facing an empty wall."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Take Projector" type="Node" parent="TerminalGame/6th Floor/Conference Room" unique_id=1469474678]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE PROJECTOR"])
_descriptions = Array[String](["It's chained to the table and pulling on the chain yields no result. It seems sturdier than the projector itself.

You are feeling more and more disturbed and annoyed with this place though. And after you provided yourself with the visitor's badge, apparently you did cross a mental line where you wouldn't mind some sort of souvenir for all this trouble."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Use Projector" type="Node" parent="TerminalGame/6th Floor/Conference Room" unique_id=1569284671]
script = ExtResource("6_g45n6")
triggers = Array[String](["USE PROJECTOR"])
add_targets = Array[String](["CHART"])
_descriptions = Array[String](["You press the on button and the little machine whirs into life, casting what looks like a sales projections chart on the wall. The order of the months along the x-axis looks all jumbled, starting the current year with July, August, [b]May[/b]. Strange.", "The projector is already on and there's no real reason to turn it off. There's no \"Next Slide\"-button. It is a projector. You would need access to the computer to progress in the presentation. But there's [b]no[/b] computer around."])
auto_increment_description = true
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Chart" type="Node" parent="TerminalGame/6th Floor/Conference Room" unique_id=219691953]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK CHART"])
hidden = true
_descriptions = Array[String](["The projected graph on the wall still shows the sales projections chart. The order of the months continues to be [b]July[/b], August, and then May."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Whiteboard" type="Node" parent="TerminalGame/6th Floor/Conference Room" unique_id=533609340]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK WHITEBOARD"])
_descriptions = Array[String](["The whiteboard is clean. There's a lone red marker pen in a little stand attached to its lower left corner.{CURSOR 2}{WAIT 0.5}{CURSOR 0}

{SPEED 0.3}WAIT...{SPEED -1}{CURSOR 2}{WAIT 0.5}{CURSOR 0}

You can barely make out an old erased text written in the center of the board in faint red:{CURSOR 2}{WAIT 1}{CURSOR 0}

{SPEED 0.5}D[b]O[/b]N'T RU[b]N[/b]!{SPEED -1}{SIGNAL shrug}"])
add_global_state = Array[String](["FOLLOWED"])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Hall Corner by Lounge" type="Node" parent="TerminalGame/6th Floor" unique_id=1571051598]
script = ExtResource("4_3equl")
location = "HALL CORNER"
state_descriptors = Dictionary[String, String]({
"FOLLOWED": " You have this unnerving feeling that at any time someone will round the other corner and confront you about what you are doing here."
})
_descriptions = Array[String](["You stand next to a door.

The hall goes off in two directions. One towards a corner that looks identical to this one, but mirrored. The other has a single door in the far end."])
add_global_state = Array[String](["LOUNGE CORNER"])
metadata/_custom_type_script = "uid://gsfx6wsb66de"

[node name="Around" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Lounge" unique_id=561888297]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
_descriptions = Array[String](["From the looks of it, the hall forms a U-shape. At least the part you can [b]see[/b] from here. Yet, you have not found any door leading into the inner area. Only out from the U."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Door Reception" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Lounge" unique_id=197977664 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR AT END OF HALL"
place = NodePath("../../6th Floor Reception")
_descriptions = Array[String](["As you walk the hall, it feels like it stretches unnecessarily far without any doors{WAIT 1} until it abruptly ends in a single door.

You waste no time lingering, instead you immediately reach to open the door."])
add_global_state = Array[String](["RECEPTION LOUNGE"])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Look Door Reception" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Lounge" unique_id=534617973]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK DOOR AT END OF HALL"])
_descriptions = Array[String](["The hall stretches far and ends in a lonely door."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Door Lounge" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Lounge" unique_id=1929152726 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR"
place = NodePath("../../Workers Lounge")
_descriptions = Array[String](["As you open the door, you feel your hand getting a little moist. The door handle must not have been entirely dry.", "You open the door to the worker's lounge."])
auto_increment_description = true
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Look Door Lounge" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Lounge" unique_id=1395484520]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK DOOR"])
_descriptions = Array[String](["There are a few stains around the handle area, but otherwise it looks just like all other doors around here. "])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Other Corner" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Lounge" unique_id=1840215606 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
target = "CORNER"
place = NodePath("../../Hall Corner by Office")
_descriptions = Array[String](["You walk over towards the the [b]mirrored[/b] corner. Though it looks otherwise the same, you do notice that the temperature drops even further. An uneasy feeling comes over you as you start to [b]shiver[/b] from the cold."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Workers Lounge" type="Node" parent="TerminalGame/6th Floor" unique_id=1713603343]
script = ExtResource("4_3equl")
location = "WORKER'S LOUNGE"
_descriptions = Array[String](["There room is quite large with three circular tables, no [b]chairs[/b], and a kitchen area with several microwaves, a dish washer and off to the side one of those institutional coffee machines."])
metadata/_custom_type_script = "uid://gsfx6wsb66de"

[node name="Around" type="Node" parent="TerminalGame/6th Floor/Workers Lounge" unique_id=1870418580]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
_descriptions = Array[String](["You didn't notice it first, because the lack of chairs got you distracted, but there also aren't any windows. In fact you haven't seen a single window since going up the elevator.

You wouldn't want to spend your lunch breaks here."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Door" type="Node" parent="TerminalGame/6th Floor/Workers Lounge" unique_id=1079187788 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR"
place = NodePath("../../Hall Corner by Lounge")
_descriptions = Array[String](["You exit the worker's lounge."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Tables" type="Node" parent="TerminalGame/6th Floor/Workers Lounge" unique_id=850860588]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK TABLES"])
_descriptions = Array[String](["All three tables look exactly the same. Round. Clean. Not a bread crumb on them, which perhaps isn't all too strange given that there are no chairs in the room."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Coffe Machine" type="Node" parent="TerminalGame/6th Floor/Workers Lounge" unique_id=1053836553]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK COFFEE MACHINE", "USE COFFEE MACHINE"])
add_targets = Array[String](["COFFEE", "HOT CHOCOLATE"])
_descriptions = Array[String](["It looks like a mid-sized machine suitable for a work place with well over ten people working there.

It offers both coffee and [b]hot[/b] chocolate."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Coffee" type="Node" parent="TerminalGame/6th Floor/Workers Lounge" unique_id=1634540720]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE COFFEE", "MAKE COFFEE"])
hidden = true
_descriptions = Array[String](["The machine gurgles, buzzes and then starts to spurt out a steaming black liquid into a paper cup.

You are indeed very cold and a bit of coffee couldn't hurt.{SIGNAL cup}

It tastes, well not great.{WAIT 0.5} There's a metallic tone,{WAIT 0.5} as if there's something wrong with the water,{WAIT 0.5} and it is sour.{CURSOR 2}{MORE}{CURSOR 0}{CLEAR}

Still, you needed to warm up a bit.", "One coffee is more than enough. It was rather disgusting."])
auto_increment_description = true
add_global_state = Array[String](["WARMTH"])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Hot Chocolate" type="Node" parent="TerminalGame/6th Floor/Workers Lounge" unique_id=890313053]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE HOT CHOCOLATE", "MAKE HOT CHOCOLATE"])
hidden = true
_descriptions = Array[String](["The machine gurgles, buzzes, stutters and then starts to spurt out a steaming thick liquid into a paper cup.{SIGNAL cup}{WAIT 0.5}

It smells delicious!{WAIT 1}

The hot thick liquid fills your stomach with a sweet warmth.{WAIT 2} And then radiates out into your body. Almost as if your blood was getting replaced by a thick chocolatey liquid...{MORE}{CURSOR 0}{CLEAR}

You did [b]need[/b] that.", "Chocolate is quite filling, and you cannot see yourself drinking another."])
auto_increment_description = true
add_global_state = Array[String](["WARMTH"])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Hall Corner by Office" type="Node" parent="TerminalGame/6th Floor" unique_id=603018479]
script = ExtResource("4_3equl")
location = "COLD HALL CORNER"
_descriptions = Array[String](["You stand next to a door where the hall makes a corner. It is ridiculously [b]cold[/b].

One way leads towards a corner that looks identical to this one, but mirrored. The other has a single door in the far end."])
metadata/_custom_type_script = "uid://gsfx6wsb66de"

[node name="Around" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Office" unique_id=1880874878]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
_descriptions = Array[String](["From the looks of it, the hall forms a U-shape. At least the part you can see from here. Yet, you have not found any door leading into the inner area. Only out from the U."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Door Antechamber" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Office" unique_id=1062854190 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR"
place = NodePath("../../Antechamber")
_descriptions = Array[String](["As you reach for the handle, you pull back, it’s that cold, [b]freezing[/b].{WAIT 1}{SIGNAL cold}

Still you need to see this through, so wrapping your hand in the bottom of your t-shirt, you reach and quickly jerk the door up.", "You open the door to the antechamber,{SIGNAL cold} still as [b]cold[/b] as the first time."])
auto_increment_description = true
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Look Door Antechamber" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Office" unique_id=1199145354]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK DOOR"])
_descriptions = Array[String](["As you look closer, you notice that there are small ice crystals on the door handle. It seems that this is where the cold is coming from."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Other Corner" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Office" unique_id=1462367302 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
target = "CORNER"
place = NodePath("../../Hall Corner by Lounge")
_descriptions = Array[String](["You walk over towards the the mirrored corner. Though it looks otherwise the same, you notice that the temperature rises slightly."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Door Reception" type="Node" parent="TerminalGame/6th Floor/Hall Corner by Office" unique_id=838894941 node_paths=PackedStringArray("place")]
