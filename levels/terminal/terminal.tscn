[node name="Terminal Boot" type="Node" parent="." unique_id=1515797097 node_paths=PackedStringArray("main", "input", "options")]
script = ExtResource("3_6a7pf")
main = NodePath("../AspectRatioContainer/MarginContainer/VBoxContainer/Main Text")
input = NodePath("../AspectRatioContainer/MarginContainer/VBoxContainer/Input Line")
options = NodePath("../AspectRatioContainer/MarginContainer/VBoxContainer/Options Line")
boot_sequence = "{CURSOR 0}{SPEED 0.3}...{CURSOR 1 0.1}{CLEAR}{SPEED 0}
LOADING BIOS{WAIT 2}
CHECKING MEMORY{WAIT 1}
LOADING GAME-OS{WAIT 2}
{CLEAR}
WELCOME TO GAME-OS
YOUR COMPLETE GAME EXPERIENCE (TM)

C:> {CURSOR 2 0.4}"
load_game_squence = "{SPEED 0.4}A:

{SPEED 0}A:> {WAIT 1}{SPEED 0.4}DIR
{CURSOR 0}{SPEED 0}do_not_run.exe    60k{WAIT 0.1}
do_not_run.dat    1.2M{WAIT 0.1}

A:> {CURSOR 2 0.4}{WAIT 1}{SPEED 0.15}do_not_run.exe{WAIT 5}{CURSOR 0}
{SPEED 0}Loading{SPEED 0.6}...
{CLEAR}"

