[node name="Ground Floor" type="Node" parent="TerminalGame" unique_id=1983827917]

[node name="Car" type="Node" parent="TerminalGame/Ground Floor" unique_id=1432951969]
script = ExtResource("4_3equl")
location = "CAR"
_descriptions = Array[String](["Fortunately, you found a parking place right outside the address that the rather stern letter had directed you to.

It is a nondescript six stories tall brick building in the middle of a block. The street is busy.", "You are sitting in your car outside the building indicated in the letter you received in the mail two days ago."])
auto_increment_description = true

[node name="Around" type="Node" parent="TerminalGame/Ground Floor/Car" unique_id=190138477]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
add_targets = Array[String](["LETTER"])
_descriptions = Array[String](["The car is turned off, there's a letter laying on the passenger seat and outside you see the brick building with the entrance marked 60."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Letter" type="Node" parent="TerminalGame/Ground Floor/Car" unique_id=324606626]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK LETTER"])
hidden = true
_descriptions = Array[String](["Dear Sir or Madam

It has come to our attention that you failed to attend the scheduled meeting on the 24th of October, 2026.

You have seven days to present yourself at the our offices or your case will be handed over to the authorities.

Best Regards, 
Dir. S Man 
THE Method Emporium 
South Utopia Corner Key Street 60 {CURSOR 2}{MORE}{CURSOR 0}{CLEAR} You had never heard of the company, any meeting or in fact the street before you you got this letter."])

[node name="Pickup Letter" type="Node" parent="TerminalGame/Ground Floor/Car" unique_id=505422492 node_paths=PackedStringArray("pickup")]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE LETTER"])
pickup = [NodePath("../Letter")]
autohide = true
autoblock = true
hidden = true
_descriptions = Array[String](["You pick up the letter from the passenger seat and cram it into your back pocket."])

[node name="Door" type="Node" parent="TerminalGame/Ground Floor/Car" unique_id=383017852 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR"
place = NodePath("../../Outside")
_descriptions = Array[String](["Opening the door, you step out of the car onto the sidewalk."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Car" type="Node" parent="TerminalGame/Ground Floor/Car" unique_id=1165967657]
script = ExtResource("6_g45n6")
triggers = Array[String](["USE CAR"])
_descriptions = Array[String](["You spent all day yesterday thinking about the letter. Procrastinating. But you are here now and there is no way you are going to leave before this thing, whatever it is, has been sorted out.", "No, there's no going back home. Not until this has been dealt with."])
auto_increment_description = true
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Outside" type="Node" parent="TerminalGame/Ground Floor" unique_id=748236538]
script = ExtResource("4_3equl")
location = "SIDEWALK"
_descriptions = Array[String](["For such a busy street, with cars flying by in both directions, the sidewalk is surprisingly deserted.

Your car is parked right in front of the entrance - two big sliding, tinted doors. There are no markings, logos or other such clutter to be seen. Except for an oversized, yet quite discrete, \"60\" above the door."])
metadata/_custom_type_script = "uid://gsfx6wsb66de"

[node name="Around" type="Node" parent="TerminalGame/Ground Floor/Outside" unique_id=1254069516]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
_descriptions = Array[String](["There's not much to see. The glass doors are too opaque to spot what is waiting inside. Your car is in need of a wash, but it has seen worse days."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Car" type="Node" parent="TerminalGame/Ground Floor/Outside" unique_id=952882972 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
place = NodePath("../../Car")
_descriptions = Array[String](["You decide that you need a moment to collect yourself inside your car."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Lobby" type="Node" parent="TerminalGame/Ground Floor/Outside" unique_id=1353610724 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
place = NodePath("../../Lobby")
_descriptions = Array[String](["As you approach the large glass doors, they silently slide apart."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Lobby" type="Node" parent="TerminalGame/Ground Floor" unique_id=832491511]
script = ExtResource("4_3equl")
location = "LOBBY"
_descriptions = Array[String](["The lobby is deserted. At first glance you notice a flat-screen monitor on one wall is showing the building information, an elevator is located in the back, and a set of doors  seems to lead to a pair of toilets."])
metadata/_custom_type_script = "uid://gsfx6wsb66de"

[node name="Around" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=190693187]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
add_targets = Array[String](["STAND", "POSTERS"])
_descriptions = Array[String](["In one corner you see a stand with what looks like brochures. On the wall opposite the toilets, there are several posters."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Outside" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=976001116 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
place = NodePath("../../Outside")
_descriptions = Array[String](["For a moment, you feel like the doors will refuse to let you out, but then, when you are almost about to walk right into them, they slide apart."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Toilet" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=1328740194 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
place = NodePath("../../Lobby Toilet")
_descriptions = Array[String](["The toilet doors are both unlocked, you pick the left one. \"At random,\" you think to yourself."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Elevator" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=1437831941 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
target = "ELEVATOR"
place = NodePath("../../Elevator")
_descriptions = Array[String](["You cross to the far side of the rather spacious and desolate lobby where the elevator is located. "])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Posters" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=1919687158]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK POSTERS"])
hidden = true
_descriptions = Array[String](["There are three posters.

The first one depicts a desk with a red typewriter. There’s no text or message on it.

The second one depicts what looks like a worker's lounge with a coffee machine to one corner and the text: \"DRINK FIRST.\"

The last poster has the word \"TOGETHER\" repeated over and over in different colors. It looks quite different from the other two. "])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Take Posters" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=666479732]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE POSTERS"])
_descriptions = Array[String](["The do look kinda sick, in an ironic way. Looking around, you see no obvious surveillance equipment.{WAIT 1}

However, it'd be way too awkward to waltz into this meeting with their own posters as loot under one arm. Maybe on the way out though, if things go south.", "Nope, at least not yet."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Stand" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=154872230]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK STAND"])
add_targets = Array[String](["LETTER"])
hidden = true
_descriptions = Array[String](["The brochures seems to be a mix of advertisements about renting office space in the building, info about fire escape routes, and other material that doesn't seem to apply to you.

However, as you browse through the brochures on the stand you notice that someone has shoved a letter, just like yours, behind the fire escape plans."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Pickup Hidden Letter" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=1762434516]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE LETTER"])
hidden = true
_descriptions = Array[String](["You consider it for a moment. Then decide that it's best to leave this letter here and bring your own, even though they seem identical. You never know."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Hidden Letter" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=817801818]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK LETTER"])
hidden = true
_descriptions = Array[String](["Dear Sir or Madam

It has come to our attention that you failed to attend the scheduled meeting on the 24th of October, 2026.

You have seven days to present yourself at the our offices or your case will be handed over to the authorities.

Best Regards,
Dir. S Man
THE Method Emporium
South Utopia Corner Key Street 60 {CURSOR 2}{MORE}{CURSOR 0}{CLEAR} 
Exactly like your letter. What can this mean?"])

[node name="TV" type="Node" parent="TerminalGame/Ground Floor/Lobby" unique_id=1319756500]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK TV", "USE TV"])
_descriptions = Array[String](["The television shows who is renting on what floor. You easily find that the people you are here for are all the way up on the 6th floor."])
add_global_state = Array[String](["KNOWS FLOOR"])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Lobby Toilet" type="Node" parent="TerminalGame/Ground Floor" unique_id=1091732625]
script = ExtResource("4_3equl")
location = "TOILET"
_descriptions = Array[String](["Even though the lobby looked spotless and you've yet to see another human being, the toilet looks heavily used. There are several stains in the bowl and the water isn't clear.{SIGNAL disgusting} Further, there isn't any paper.

There’s a sink and a mirror on the left wall and someone has scribbled a poem on the right."])
metadata/_custom_type_script = "uid://gsfx6wsb66de"

[node name="Around" type="Node" parent="TerminalGame/Ground Floor/Lobby Toilet" unique_id=155795907]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
_descriptions = Array[String](["Not doing that, no. Too disgusting here."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Toilet" type="Node" parent="TerminalGame/Ground Floor/Lobby Toilet" unique_id=1100058159]
script = ExtResource("6_g45n6")
triggers = Array[String](["USE TOILET"])
_descriptions = Array[String](["You aren't that desperate. Yet."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Take Toilet" type="Node" parent="TerminalGame/Ground Floor/Lobby Toilet" unique_id=447879282]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE TOILET"])
_descriptions = Array[String](["It is stuck to the floor. Fortunately."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Mirror" type="Node" parent="TerminalGame/Ground Floor/Lobby Toilet" unique_id=817961094]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK MIRROR", "USE MIRROR"])
_descriptions = Array[String](["Your reflection looks nervous. You really don't want to be here."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Door" type="Node" parent="TerminalGame/Ground Floor/Lobby Toilet" unique_id=1790437774 node_paths=PackedStringArray("place")]
script = ExtResource("7_iaufv")
actions = Array[String](["GO", "USE"])
target = "DOOR"
place = NodePath("../../Lobby")
_descriptions = Array[String](["You leave the filthy toilet behind, regretting that you went in there."])
metadata/_custom_type_script = "uid://b3qt00giuv02a"

[node name="Poem" type="Node" parent="TerminalGame/Ground Floor/Lobby Toilet" unique_id=212812240]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK POEM"])
_descriptions = Array[String](["This winter's been quite absurd.
You'd better believe my word:
I came in for a dump,
but from my rump
came a solid icicle-turd.!"])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

