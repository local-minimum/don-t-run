[node name="Car" type="Node" parent="TerminalGame" unique_id=1432951969]
script = ExtResource("4_3equl")
_descriptions = Array[String](["It is a non-descript six stories tall brick building in the middle of a block on a busy street.

Fortunately, you had found a parking place right outside the address that the rather stern letter had directed you to.", "You are stting in your car outside the building indicated in the letter you received in the mail two days ago."])

[node name="Around" type="Node" parent="TerminalGame/Car" unique_id=190138477]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK AROUND"])
_descriptions = Array[String](["The car is turned off, there's a letter laying on the passanger seat and outside you see the brick building with the entrance marked 60."])
metadata/_custom_type_script = "uid://br3ay75u35q2m"

[node name="Letter" type="Node" parent="TerminalGame/Car" unique_id=324606626]
script = ExtResource("6_g45n6")
triggers = Array[String](["LOOK LETTER"])
hidden = true
_descriptions = Array[String](["The letter reads:

Dear Sir or Madam

It has come to our attention that you failed to attend the the scheduled meeting on the 24th of October, 2026.

You have seven days to present yourself at the downtown offices or your case will be handed over to the authorities.

Best Regards,
Dir. S Man
THE M Engine
South Utopia Corner Key Street 60

You had never heard of the company, any meeting or in fact the street before you you got this letter."])

[node name="Pickup Letter" type="Node" parent="TerminalGame/Car" unique_id=505422492]
script = ExtResource("6_g45n6")
triggers = Array[String](["TAKE LETTER"])
add_global_action_target = "LETTER"
autohide = true
hidden = true
_descriptions = Array[String](["You pick up the letter from the passanger seat and cram it into your back pocket."])

[node name="Door" type="Node" parent="TerminalGame/Car" unique_id=383017852]
